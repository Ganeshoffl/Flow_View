{
  "name": "flow-view-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "flow_view — see what your code does while it runs",
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "schema:gen": "python3 packages/trace-schema/generate.py",
    "schema:check": "python3 packages/trace-schema/generate.py --check",
    "build": "pnpm -r --filter './packages/**' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter @flow-view/web dev",
    "verify": "pnpm schema:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
