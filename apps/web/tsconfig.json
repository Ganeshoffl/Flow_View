{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client", "node"],
    "paths": {
      "@flow-view/trace-schema": ["../../packages/trace-schema/src/index.ts"],
      "@flow-view/trace-schema/validate": ["../../packages/trace-schema/src/validate.ts"],
      "@flow-view/trace-store": ["../../packages/trace-store/src/index.ts"],
      "@flow-view/trace-fixtures": ["../../packages/trace-fixtures/src/index.ts"],
      "@flow-view/renderers": ["../../packages/renderers/src/index.ts"],
      "@flow-view/inference": ["../../packages/inference/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
